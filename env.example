# ── Gateway Credentials (from EUPaymentz) ─────────────────────────────────────
GATEWAY_ACCOUNT_ID=your_account_id_here
GATEWAY_PASSWORD=your_password_here
GATEWAY_PASSPHRASE=your_passphrase_here

# ── Shopify (from your Partner Dashboard / App settings) ──────────────────────
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# ── App URL (your Railway deployment URL, no trailing slash) ──────────────────
# Example: https://shopify-gateway-production.up.railway.app
APP_URL=https://your-app.up.railway.app

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
